{
  "manifest_version": 3,
  "name": "Мои домены",
  "version": "1.1.3",
  "author": "Илья Старков <ipbatman69@gmail.com>",
  "description": "Домены посещённых сайтов и фоновых запросов: локальный сбор, поиск и экспорт.",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Мои домены",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
